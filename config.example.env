# Copia este archivo como config.env (que NO se sube a GitHub) y rellénalo.
#   cp config.example.env config.env && chmod 600 config.env

# Carpeta Rush sincronizada con Google Drive para ordenador (ajusta tu email/carpeta)
RUSH_DIR="$HOME/Library/CloudStorage/GoogleDrive-TU_EMAIL/Mi unidad/Rush"
# Carpeta donde el agente deja los montajes terminados
EXPORT_DIR="$HOME/Library/CloudStorage/GoogleDrive-TU_EMAIL/Mi unidad/Export"

# ntfy: inventa un nombre de tema largo y difícil de adivinar, y suscríbete en la app ntfy del móvil
NTFY_TOPIC="sherine-montage-CAMBIA-ESTO-por-algo-aleatorio"

# URL de la Web App de Google Apps Script (scripts/google-sheet.gs)
SHEET_WEBHOOK_URL=""
# Clave compartida con el Apps Script para que nadie más escriba en tu Sheet
SHEET_KEY=""

# Minutos que un archivo debe estar sin cambios antes de montarlo (Drive tarda en sincronizar)
MIN_EDAD_MIN=3
